<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ui.DetailController" prefWidth="860" prefHeight="600">
    <top>
        <HBox styleClass="dialog-header" alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="titleLabel" styleClass="page-title" wrapText="true"/>
                    <Label fx:id="statusPill" styleClass="status-pill" minWidth="-Infinity"/>
                </HBox>
                <Label fx:id="subtitleLabel" styleClass="muted"/>
            </VBox>
            <Button text="Edit" styleClass="btn-secondary" onAction="#onEdit" minWidth="-Infinity"/>
            <Button text="Delete" styleClass="btn-danger" onAction="#onDelete" minWidth="-Infinity"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="card-scroll">
            <HBox spacing="20">
                <padding>
                    <Insets top="20" right="24" bottom="20" left="24"/>
                </padding>

                <VBox spacing="16" minWidth="320" maxWidth="320">
                    <StackPane fx:id="imageWell" styleClass="image-well" onMouseClicked="#onImageClicked"
                               minWidth="320" prefWidth="320" maxWidth="320"
                               minHeight="240" prefHeight="240" maxHeight="240">
                        <Label fx:id="imagePlaceholder" styleClass="card-media-placeholder"/>
                        <ImageView fx:id="productImage" fitWidth="320" fitHeight="240" preserveRatio="true" smooth="true"/>
                    </StackPane>

                    <VBox styleClass="surface" spacing="12">
                        <Label text="Receipt" styleClass="section-title"/>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <StackPane styleClass="receipt-thumb" minWidth="120" prefWidth="120" maxWidth="120"
                                       minHeight="90" prefHeight="90" maxHeight="90">
                                <Label fx:id="receiptPlaceholder" styleClass="muted"/>
                                <ImageView fx:id="receiptImage" fitWidth="120" fitHeight="90" preserveRatio="true" smooth="true"/>
                            </StackPane>
                            <VBox spacing="8">
                                <Button fx:id="openReceiptButton" text="Open" styleClass="btn-secondary"
                                        onAction="#onOpenReceipt" maxWidth="Infinity"/>
                                <Button fx:id="attachReceiptButton" text="Attach" styleClass="btn-secondary"
                                        onAction="#onAttachReceipt" maxWidth="Infinity"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox spacing="16" HBox.hgrow="ALWAYS">
                    <VBox styleClass="surface" spacing="16">
                        <GridPane hgap="16" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="100"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Model" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="modelValue" styleClass="field-value" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Retailer" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="retailerValue" styleClass="field-value" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Purchased" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="purchasedValue" styleClass="field-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Warranty" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="durationValue" styleClass="field-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <Label text="Expires" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <Label fx:id="expiresValue" styleClass="field-value" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        </GridPane>
                        <VBox spacing="6">
                            <ProgressBar fx:id="progressBar" styleClass="progress-slim" maxWidth="Infinity"/>
                            <Label fx:id="progressLabel" styleClass="muted"/>
                        </VBox>
                    </VBox>

                    <VBox styleClass="surface" spacing="10">
                        <Label text="Helpful links" styleClass="section-title"/>
                        <VBox fx:id="linkList" styleClass="link-list"/>
                    </VBox>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="dialog-footer" alignment="CENTER_RIGHT">
            <Button text="Close" styleClass="btn-ghost" cancelButton="true" onAction="#onClose"/>
        </HBox>
    </bottom>
</BorderPane>
